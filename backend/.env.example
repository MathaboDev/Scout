DJANGO_SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
DB_CONN_MAX_AGE=0

CORS_ALLOWED_ORIGINS=http://localhost:5173FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Scout <no-reply@example.com>

# Bookmark reminders (FR21): automatic background check, interval in seconds
REMINDERS_AUTORUN=True
REMINDER_CHECK_INTERVAL=600

# Production: the backend's own https address (for the Django admin site)
CSRF_TRUSTED_ORIGINS=
